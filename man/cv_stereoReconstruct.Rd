\name{cv_stereoReconstruct}
\alias{cv_stereoReconstruct}
\title{Stereo 3D reconstruction from a pair of images}
\usage{cv_stereoReconstruct(image1, image2, K1, D1, xi1, K2, D2, xi2, R, T, flag,
    numDisparities, SADWindowSize, newSize = NULL, Knew = NULL,
    pointType = XYZRGB, disparity = NULL, image1Rec = NULL, image2Rec = NULL,
    pointCloud = NULL)}
\arguments{
\item{image1}{The first input image}
\item{image2}{The second input image}
\item{K1}{Input camera matrix of the first camera}
\item{D1}{Input distortion parameters for the first camera}
\item{xi1}{Input parameter xi for the first camera for CMei's model}
\item{K2}{Input camera matrix of the second camera}
\item{D2}{Input distortion parameters for the second camera}
\item{xi2}{Input parameter xi for the second camera for CMei's model}
\item{R}{Rotation between the first and second camera}
\item{T}{Translation between the first and second camera}
\item{flag}{Flag of rectification type, RECTIFY_PERSPECTIVE or RECTIFY_LONGLATI}
\item{numDisparities}{The parameter 'numDisparities' in StereoSGBM, see StereoSGBM for details.}
\item{SADWindowSize}{The parameter 'SADWindowSize' in StereoSGBM, see StereoSGBM for details.}
\item{newSize}{Image size of rectified image, see omnidir::undistortImage}
\item{Knew}{New camera matrix of rectified image, see omnidir::undistortImage}
\item{pointType}{Point cloud type, it can be XYZRGB or XYZ}
\item{disparity}{Disparity map generated by stereo matching}
\item{image1Rec}{Rectified image of the first image}
\item{image2Rec}{rectified image of the second image}
\item{pointCloud}{Point cloud of 3D reconstruction, with type CV_64FC3}
}
\value{返回输出图像（\code{cvMat}）。}
\description{Stereo 3D reconstruction from a pair of images.}
\details{
\strong{C++ 头文件：}\code{#include <opencv2/ccalib/omnidir.hpp>}
}
